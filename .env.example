########################################
# 🧠 AI SEARCH SERVICE (DATABASE)
########################################

DATABASE_URL=postgresql://user:password@localhost:5432/ai_search_db  
# Full connection string used by ORM/driver

POSTGRES_USER=ai_user                  # PostgreSQL username
POSTGRES_PASSWORD=secure_password      # PostgreSQL password
POSTGRES_DB=ai_search_db               # Database name

POSTGRES_HOST=localhost                # Database host
POSTGRES_PORT=5432                     # Database port


########################################
# 🐇 RABBITMQ (MESSAGING)
########################################

RABBITMQ_PROTOCOL=amqp                 # Protocol (amqp or amqps)
RABBITMQ_HOST=localhost                # RabbitMQ host
RABBITMQ_PORT=5672                     # RabbitMQ port

RABBITMQ_USERNAME=user                 # RabbitMQ username
RABBITMQ_PASSWORD=password             # RabbitMQ password
RABBITMQ_VIRTUAL_HOST=/                # Virtual host


########################################
# 📦 QUEUES (EVENT CONSUMPTION)
########################################

PRODUCT_QUEUE_NAME=product_queue       # Queue for product events
SERVICE_QUEUE_NAME=service_queue       # Queue for service events
